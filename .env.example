# 复制本文件为 .env 后填写真实值。.env 不进 git。
# 没有 API Key 时，记录和搜索照常可用，只有「分身」功能不可用。

# 大模型密钥，P2 起需要
DEEPSEEK_API_KEY=

# 接口地址，默认官方，换代理时改这里
LLM_BASE=https://api.deepseek.com

# 模型名。空闲时段便宜（输入 1 元/百万 tokens，输出 4 元/百万）
LLM_MODEL=deepseek-flash

# 分身自称，用于提示词与界面
PERSONA_NAME=我

# 数据库路径，相对项目根目录。改这里就能把库放到别的盘
ME_DB=data/me.db
